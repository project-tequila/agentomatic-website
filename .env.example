# Canonical public site URL (used for metadataBase, canonicals, OG, sitemap, robots, JSON-LD)
# Production must be https://www.agentomatic.in — never agentomatic.com
NEXT_PUBLIC_SITE_URL=https://www.agentomatic.in

# API gateway (Railway production)
API_GATEWAY_URL=https://gateway-production-56d3.up.railway.app

# Production appointment booker frontend (Sign In + /signin redirect; Sign Up + /signup → booker /register; /book → /signin)
NEXT_PUBLIC_APPOINTMENT_BOOKER_URL=https://appointment-booker-nine.vercel.app

# Server-only demo secret (not shown to visitors). Must match the AI service on Railway.
# Gates both POST /api/demo/outbound-call and POST /api/demo/web-voice.
# See docs/demo-outbound-call.md and docs/demo-web-voice.md.
DEMO_OUTBOUND_API_KEY=

# Optional overrides for the demo call payload
# DEMO_VOICE_PROVIDER=twilio
# DEMO_VOICE_MESSAGE=Hello, this is Agentomatic. Thanks for trying our voice agent demo.

# Twilio / business line shown on the contact page (E.164, include + and country code)
NEXT_PUBLIC_CONTACT_PHONE=

# Server-side inbox for inbound leads only — do not render on public pages
# NEXT_PUBLIC_CONTACT_EMAIL=

# HubSpot Private App — inbound contact form → CRM (see docs/sales-os/hubspot-setup.md)
HUBSPOT_ACCESS_TOKEN=
# Optional: Agentomatic Sales pipeline + "New" stage IDs
# HUBSPOT_PIPELINE_ID=
# HUBSPOT_STAGE_NEW_ID=

# Sanity CMS (required for /blog and /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=1urzpjii
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-06-11
# SANITY_API_READ_TOKEN=

# Meta Graph API — own Facebook Page + Instagram Business publishing
# See docs/meta-publishing.md (use a dedicated content app, not appointment-booking-agent)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# META_GRAPH_API_VERSION=v22.0

# X (Twitter) MCP — Cursor mcp.json server `x-twitter` (@mbelinky/x-mcp-server)# Get keys at https://developer.x.com (app Read and write + OAuth 1.0a)
# X_API_KEY=
# X_API_SECRET_KEY=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# YouTube MCP — Cursor mcp.json server `youtube` (maagpi-youtube-mcp)
# Google Cloud Desktop OAuth client; enable YouTube Data API v3 (+ Analytics optional)
# See docs/x-youtube-mcp-publishing.md
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
